APP_NAME=Ledgerly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ledgerly
DB_USERNAME=ledgerly
DB_PASSWORD=ledgerly

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=llama3.1:8b
AI_VISION_MODEL=llama3.2-vision:11b
AI_EMBED_MODEL=nomic-embed-text
AI_EMBED_DIMENSIONS=768
AI_TOKEN_COUNTER=ratio
AI_CONTEXT_WINDOW=8192
AI_ENCODING_DEFAULT=toon
AI_ENCODING_LIST_INVOICES=

MCP_STDIO_USER_EMAIL=
SANCTUM_TOKEN_EXPIRATION=43200
AI_SEMANTIC_CACHE_REQUIRE_GROUNDING=true
AI_RETRIEVAL_FLOOR=0.70
AI_CHUNK_STRATEGY=parent-child
AI_RERANKER=sidecar
AI_RETRIEVAL_RERANK_CANDIDATES=20
AI_RETRIEVAL_REWRITE=rewrite
AI_RETRIEVAL_REWRITE_MODEL=
AI_RETRIEVAL_CONTEXT_MODEL=
AI_SIDECAR_URL=http://localhost:8008
AI_ROUTING=true
AI_ROUTING_SAMPLES=3
AI_ROUTING_AGREEMENT=0.67
AI_TRIAGE_URGENT_AMOUNT=1000

REVERB_APP_ID=ledgerly
REVERB_APP_KEY=ledgerly-local-key
REVERB_APP_SECRET=ledgerly-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

AI_QUEUED_REPLIES=true
AI_CONCURRENCY=1
